# Server
# Set DEMO_MODE=true to try the app without PostgreSQL
DEMO_MODE=true
NODE_ENV=development
PORT=8000
HOST=127.0.0.1

# Public URLs (HTTPS required for Telegram Mini App)
PUBLIC_URL=https://YOUR-HOST.sslip.io
TELEGRAM_WEB_APP_URL=https://YOUR-HOST.sslip.io

# Telegram
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
BOT_USERNAME=YourBotUsername

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_TELEGRAM_IDS=123456789

# PostgreSQL
DATABASE_URL=postgresql://getrewards:password@127.0.0.1:5432/get_rewards

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# CORS
CORS_ORIGINS=
